# Test rules

alert tcp 192.168.1.50 any -> 10.0.0.0 80 (msg:"SQL Injection; UNION"; content:"UNION SELECT"; nocase; flags:PA; severity:critical; sid:1000001;)
alert tcp any any -> any 22 (sid:1000002; severity:medium; flags:S; msg:"SSH SYN Scan";)
alert ip any any -> any any (msg:"HTTP URL check"; content:"http://evil.com"; sid:1000003;)